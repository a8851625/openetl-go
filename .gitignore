# E2E test runtime output directories
/data-*

# bench-baseline CI job tees its log to the repo root (see _gate.yml). Without
# this entry every bench run marks its own worktree dirty, which invalidates
# the source.dirty provenance signal the baseline records.
/baseline-run.log

# ETL runtime state created by package-level tests and ad-hoc local runs.
/internal/etl/**/data/
/internal/etl/**/logs/

# Playwright CLI recordings
/.playwright-cli/

# Playwright CLI recordings (transient screenshots-in-progress live here)
/.playwright-cli/

