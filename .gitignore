.pi-subagents/
.bench-out/
hack/__pycache__/
*.pyc

# Local binary / accidental root build artifacts
/openetl-go
/main
# `go build ./hack/cmd/<tool>` drops the tool binary in the cwd; that is a
# build output, never a source file.
/check-connector-evidence

# Root-level package.json is only for local agent tooling, not the product
/package.json
/package-lock.json

# Transient UI review screenshots
/web/screenshots/

# Locally generated DWH spec trees (produced by hack/gen-doris-specs-*.sh
# against real source DBs; may contain credentials — do not commit).
/pipes-dwh/
/pipes-dwh-cdc/

