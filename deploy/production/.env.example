# OpenETL-Go 生产环境变量模板
# 复制为 .env 后填写真实值；切勿提交 .env 到 Git。
#
#   cp deploy/production/.env.example deploy/production/.env
#   # 编辑 .env
#   docker compose --env-file .env -f deploy/production/docker-compose.yml up -d

# ── 镜像与时区 ──────────────────────────────────────────────────────
# 生产请钉死版本号或 digest，禁止 latest
OPENETL_IMAGE=ghcr.io/a8851625/openetl-go:v0.2.11-beta.3
TZ=Asia/Shanghai

# ── 必改：API 与 spec 加密 ──────────────────────────────────────────
# 生成示例：
#   openssl rand -hex 32
#   openssl rand -base64 32
ETL_API_TOKEN=
ETL_SPEC_ENCRYPTION_KEY=

# ── 元数据 MySQL（OpenETL 内部：spec / checkpoint / DLQ / audit）────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=openetl
MYSQL_USER=openetl
MYSQL_PASSWORD=

# 若元数据 MySQL 在 compose 外（托管 RDS），设置 external DSN 并注释 compose 内 mysql 服务：
# ETL_STORAGE_TYPE=mysql
# ETL_STORAGE_DSN=openetl:xxx@tcp(rds-host:3306)/openetl?parseTime=true&loc=UTC

# ── 运行时 State Redis（lookup / window / join 等状态；与业务 Redis 可同机不同 db）──
REDIS_PASSWORD=
# 业务 Redis sink 默认用 db=1，state 用 db=0（见 config / compose）
ETL_STATE_REDIS_DB=0

# ── DLQ 与资源 ──────────────────────────────────────────────────────
ETL_DLQ_TTL=168h
OPENETL_CPU_LIMIT=2.0
OPENETL_MEM_LIMIT=2g

# ── 业务侧：Kafka ───────────────────────────────────────────────────
# 管道 YAML 通过 ${VAR} 引用；须注入到 openetl-go 容器环境。
# 注意：brokers 必须是独立 host:port 列表项，不能用逗号拼成一个字符串。
KAFKA_BROKER_1=kafka-1:9092
KAFKA_BROKER_2=kafka-2:9092
KAFKA_BROKER_3=kafka-3:9092
KAFKA_TOPIC_ORDERS=orders
KAFKA_SASL_USER=
KAFKA_SASL_PASSWORD=
# plain | scram-sha-256 | scram-sha-512 | 留空表示无 SASL
KAFKA_SASL_MECHANISM=

# ── 业务侧：MySQL ODS（Kafka→MySQL upsert 目标，与元数据 MySQL 分离）──
ODS_MYSQL_HOST=ods-mysql.internal
ODS_MYSQL_PORT=3306
ODS_MYSQL_USER=sync
ODS_MYSQL_PASSWORD=
ODS_MYSQL_DATABASE=ods
ODS_MYSQL_TABLE=orders

# ── 业务侧：Redis 缓存（Kafka→Redis 目标）──────────────────────────
# 可与 state Redis 同实例；建议不同 db 或不同实例
CACHE_REDIS_HOST=redis
CACHE_REDIS_PORT=6379
# 与 compose 内 redis 同实例时，填与 REDIS_PASSWORD 相同的值
CACHE_REDIS_PASSWORD=
CACHE_REDIS_DB=1
CACHE_REDIS_KEY_PREFIX=order:

# ── 可选：告警 ──────────────────────────────────────────────────────
# ALERT_DINGTALK_WEBHOOK=
# ALERT_FEISHU_WEBHOOK=
# ALERT_SLACK_WEBHOOK=

# ── 可选：TLS（挂载 certs 后取消注释 compose 中 ETL_TLS_*）──────────
# ETL_TLS_CERT=/app/certs/tls.crt
# ETL_TLS_KEY=/app/certs/tls.key
